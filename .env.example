# 复制为 .env 后填入自己的值。不要提交 .env，也不要在聊天中粘贴真实 Key。
LLM_API_KEY=replace-with-your-api-key
# 填 SDK Base URL，不含 /chat/completions。
LLM_BASE_URL=https://api.deepseek.com
# 官方 API 名称，对应 DeepSeek-V4.1-Flash-1017。
LLM_MODEL=deepseek-flash
SERVER_PORT=8080

# 本地会话记忆；数据库和专用账号需提前创建，应用启动时自动建表。
AGENT_MEMORY_DB_HOST=127.0.0.1
AGENT_MEMORY_DB_PORT=3306
AGENT_MEMORY_DB_NAME=agent_memory
AGENT_MEMORY_DB_USERNAME=agent_memory
AGENT_MEMORY_DB_PASSWORD=replace-with-your-database-password
AGENT_MEMORY_DB_URL='jdbc:mysql://127.0.0.1:3306/agent_memory?connectionTimeZone=Asia/Shanghai'

# 真实班级接口：本机固定一个已登录账号；机构编码不是登录响应的业务 code。
LINGSHI_SOCIAL_BASE_URL=https://esastage2.51tyty.com/social/services/rest
LINGSHI_TOKEN=
LINGSHI_INST_ID=
LINGSHI_SERVER_ID=1201
LINGSHI_USER_ID=
LINGSHI_INST_CODE=
LINGSHI_USERNAME=
# 当前环境查询已验证不要求以下字段；其他环境按成功请求头填写。
LINGSHI_APP_TYPE=
LINGSHI_APP_VERSION=
LINGSHI_DEVICE_TYPE=
LINGSHI_DEVICE_ID=
LINGSHI_LANGUAGE=ch
LINGSHI_TIME_ZONE=GMT+0800
